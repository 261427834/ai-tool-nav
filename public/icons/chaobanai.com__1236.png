    background-color: #fff;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    padding: 0 30px;
    z-index: 2;
    top: 0;
    position: sticky;
}
.top img{
  width: 120px;
  height:46px;
}
.content{
   position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
