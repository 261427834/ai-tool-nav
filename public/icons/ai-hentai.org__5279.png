        margin-bottom: 45px;
        max-width: 90%;
    }

    .f2-features {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 35px 25px;
    }

    /* Feature items */
    .f2-box h4 {
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .f2-box p {
        font-size: 0.95rem;
        opacity: 0.78;
        line-height: 1.45;
    }

    /* Icons with glowing theme */
    .f2-icon {
        font-size: 2rem;
        color: #b86bff;
        margin-bottom: 12px;
        text-shadow: 0 0 15px rgba(155,44,255,0.6);
    }

    /* RIGHT IMAGE */
    .f2-right img {
        width: 100%;
        border-radius: 20px;
        box-shadow: 0 0 25px rgba(0,0,0,0.45);
        transition: transform .35s ease, box-shadow .35s ease;
    }

    .f2-right img:hover {
        transform: scale(1.03);
        box-shadow: 0 0 35px rgba(155,44,255,0.35);
    }

    /* Fade-in animation */
    .fade-in {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity .8s ease, transform .8s ease;
    }
    .fade-visible {
        opacity: 1 !important;
        transform: translateY(0) !important;
    }

    /* Responsive */
    @media (max-width: 950px) {
        .f2-wrapper {
            grid-template-columns: 1fr;
            text-align: center;
        }
        .f2-sub {
            margin: 0 auto 40px;
        }
        .f2-features {
            grid-template-columns: 1fr 1fr;
            justify-items: center;
        }
    }

    @media (max-width: 600px) {
        .f2-features {
            grid-template-columns: 1fr;
            gap: 25px;
        }
        .f2-left h2 {
            font-size: 2.2rem;
        }
    }
</style>

<!-- ========================= FEATURE 2COL JS ========================= -->
<script>
    // Fade-in on scroll
    const fade2 = document.querySelectorAll(".fade-in");
    const observer2 = new IntersectionObserver((entries)=>{
        entries.forEach(entry=>{
            if(entry.isIntersecting){
                entry.target.classList.add("fade-visible");
            }
        });
    }, {threshold:0.2});

    fade2.forEach(el => observer2.observe(el));
</script>

