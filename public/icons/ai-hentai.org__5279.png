<!-- ========================= IMAGE + TEXT JS ========================= -->
<script>
    // Fade-in animation
    const fadeTaste = document.querySelectorAll(".fade-in");
    const observerTaste = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add("fade-visible");
            }
        });
    }, { threshold: 0.3 });

    fadeTaste.forEach(el => observerTaste.observe(el));
</script>



