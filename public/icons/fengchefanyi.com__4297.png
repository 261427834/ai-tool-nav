        }

        .box2 .tab_item {
            width: 7.8571rem;
            height: 2.5238rem;
            background: #FFFFFF;
            margin-right: 5.0952rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .box2 .tab_item:hover {
            color: #0152D9;
        }

        .box2 .tab_item:last-child {
            margin-right: 0;
        }

        .box2 .tab_item_active {
            background: #0152D9;
            color: #fff;
        }

        .box2 .tab_item_active:hover {
            color: #fff;
        }

        .tab_content {
            width: 100%;
            height: 21.6667rem;
            position: relative;
            bottom: 9.4286rem;
        }

        .tab_content .content_box {
