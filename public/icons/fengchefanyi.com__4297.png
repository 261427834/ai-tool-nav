    <script>
        $(function () {
            changeTab(0)
        })
        $('.jump_box').on('mouseenter', function () {
            $(this).children('img').attr('src', 'https://fanyi-1323968691.cos.ap-guangzhou.myqcloud.com/images/arrow_white.svg')
        })
        $('.jump_box').on('mouseleave', function () {
            $(this).children('img').attr('src', 'https://fanyi-1323968691.cos.ap-guangzhou.myqcloud.com/images/arrow.svg')
        })
        $('.box2_item').on('mouseenter', function () {
            $(this).addClass('card_item_active')
            $(this).children('.jump_item').css('display', 'block').animate({ bottom: "1.5238rem" }, 0, 'linear')
        })
        $('.box2_item').on('mouseleave', function () {
            $(this).removeClass('card_item_active')
            $(this).children('.jump_item').css('display', 'none').animate({ bottom: "0" }, 0, 'linear')
        })
        function changeTab(i) {
            $('.tab_item').eq(i).addClass('tab_item_active').siblings().removeClass('tab_item_active')
            let title = ""
            let content = ""
            if (i === 0) {
                title = "跨境电商·翻译"
                content = "为跨境电商平台提供产品图片上的文字翻译，确保信息准确传达给目标市场，提供视频内容的字幕翻译及配音，帮助品牌有效地与国际客户沟通。"
            }
            if (i === 1) {
                title = "医疗文献·翻译"
                content = "处理医学图表、研究结果等图片中的信息翻译，确保专业术语的准确性，翻译医疗讲座、培训视频等内容，以便向全球医疗从业者传播最新研究成果"
            }
            if (i === 2) {
                title = "行业研报·翻译"
                content = "针对行业研报中的数据图表、插图等进行专业翻译，保证信息的清晰理解，翻译行业会议、论坛等视频内容，帮助客户获取行业最新动态。"
            }
            if (i === 3) {
                title = "出境游学·翻译"
                content = "为出镜游学项目提供宣传材料和课程内容的图片翻译，吸引国际学生，翻译课程介绍、学生体验分享等视频，让更多人了解游学项目的优势和特色。"
            }
            $('#tabContent').text(content)
            $('#tabTitle').text(title)
            $('#tabPic').attr('src', 'https://fanyi-1323968691.cos.ap-guangzhou.myqcloud.com/images/pic' + (i + 1) + '.png')
        }
    </script>
</body>

</html>