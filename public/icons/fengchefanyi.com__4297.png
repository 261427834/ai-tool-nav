            text-align: center;
            margin-top: 15.5714rem;
            margin-bottom: 4.0476rem;
        }

        .box2 .card_list {
            display: flex;
            justify-content: space-between;
            position: absolute;
            width: 100%;
            left: 0;
            top: 0;
            z-index: 10;
        }

        .box2 .card_item {
            width: 17.1429rem;
            height: 13.1905rem;
            background: #FFFFFF;
            border-radius: .619rem;
            border: .1429rem solid #FFFFFF;
            position: relative;
            top: -1.0952rem;
            transition: all .1s;
        }

        .box2 .card_item_active {
            height: 15.381rem;
            top: -3.2381rem;
        }

        .box2 .card_item .card_item_content {
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            top: -3.0952rem;
        }

        .box2 .jump_item {
            display: none;
            color: #0152D9;
            font-size: .9048rem;
            position: absolute;
            width: 100%;
            bottom: 0;
            /* bottom: 1.5238rem; */
            transition: all .1s;
            cursor: pointer;
        }

        .box2 .jump_item>div {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .box2 .jump_item img {
            width: 1.2857rem;
            height: 1.2857rem;
            margin-left: .5238rem;
        }

        .box2 .card_item .card_item_content>img {
            width: 7.6667rem;
            height: 7.6667rem;
        }

        .box2 .card_item .card_item_title {
            font-size: 1.2857rem;
            color: #181818;
            margin-bottom: 1rem;
        }

        .box2 .card_item .card_item_text {
            color: #4B5B76;
            line-height: 1.5238rem;
            text-align: center;
            font-size: 1rem;
        }



        .box2 .tab_list {
            display: flex;
