         * 预处理注入的 config 信息
         * @param config config
         * @returns {*} 处理后的 config 信息
         */
        function getSiteConfigV2(config) {
            let stage = 'prod' || 'prod';
            // pub 的预注入变量是 dev、prod_test、prod，这里对 dev 进行一个转化为 sit
            stage = stage === 'dev' ? 'sit' : stage
            return config ? config[stage] || config : config;
        }
