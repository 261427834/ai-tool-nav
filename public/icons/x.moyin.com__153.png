        }
        _collect.q = _collect.q || []
        win[export_obj] = _collect
      }
      win[export_obj].l = +new Date()
    })(window, 'collectEvent')</script><script crossorigin="anonymous" async src="https://lf3-data.volccdn.com/obj/data-static/log-sdk/collect/5.0/collect-rangers-v5.0.0.js"></script><script>var href = window.location.href
    var HS_appId
    if (href.includes('www.moyin.com')) {
      HS_appId = 327126
    } else {
      HS_appId = 328975
    }

    function __getUrlKeyWord(keyWord) {
      let keyAfter = location.href.split(`${keyWord}=`)[1]
      let value = ''
      if (keyAfter) {
        value = keyAfter.split('&')[0]
      }
      return value
    }
    setTimeout(() => {
      // 1.2 初始化SDK
      // 定义一个全局函数 window.collectEvent，用来配置和发送事件。
      window.collectEvent('init', {
        app_id: HS_appId,
        channel: 'cn', ////数据发送地址
        log: false, // 开启调试日志
        // enable_ab_test: false, // boolean类型，是否开启A/B实验功能
        autotrack: false, //开启全埋点采集,默认关闭，需要热力图及圈选功能可开启
        disable_sdk_monitor: true, // 禁止默认sdk的load事件&error事件
        disable_session: true, // 禁止心跳检测
        disable_tracer: true, // 禁止统计事件
        spa: true,
        enable_ab_test: true, // boolean类型，是否开启A/B实验功能
        enable_ab_visual: true, // boolean类型，按需开启，默认关闭，是否开启A/B实验的可视化编辑模式功能
        enable_multilink: false, //boolean类型，按需开启，默认关闭，是否开启A/B实验的多链接实验功能，默认为false
        multilink_timeout_ms: 1000 //number类型，A/B实验的多链接实验中关闭遮罩层的时间，默认500毫秒
      })
      // 这里可以添加设置用户 id，自定义事件，设置公共属性的代码

      let bd_vid, promotsource, promottype
      let href = location.href
      promottype = __getUrlKeyWord('promottype')
      let bd_Obj = localStorage.getItem('bd_Obj')
      if (promottype) {
        promotsource = __getUrlKeyWord('promotsource')
        bd_vid = __getUrlKeyWord('bd_vid')
      } else if (
        __getUrlKeyWord('channelCode') &&
        href.indexOf('promottype') == -1 &&
        href.indexOf('bd_vid') == -1 &&
        href.indexOf('promotsource') == -1
      ) {
        promotsource = 'PC'
        promottype = 'FENXIAO'
      } else if (bd_Obj) {
        ;({ bd_vid, promotsource, promottype } = JSON.parse(bd_Obj))
      }
      if (promottype) {
        window.collectEvent('config', {
          bd_vid,
          promotsource,
          promottype
        })
      }
      window.collectEvent('config', {
        ww_device_platform: 'web',
        ww_device_platform_detail: 'pc'
      })
  
      window.collectEvent('start') //通知 SDK 所有设置已经完备，可以真正开始发送事件了。
    }, 10)</script></html>