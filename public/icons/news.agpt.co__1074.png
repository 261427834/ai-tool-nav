ems-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"flex h-4 w-4 items-center justify-center rounded-full bg-purple-50\",\"children\":\"$L73\"}],\"$L74\"]}],\"$L75\",\"$L76\"]}],\"$L77\"]}]]}]}]\n"])</script><script>self.__next_f.push([1,"4a:[\"$\",\"div\",null,{\"className\":\"order-3 relative rounded-2xl bg-gradient-to-br from-zinc-300 via-zinc-400 to-zinc-500 p-px transition-opacity md:order-none md:my-5\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative flex h-full flex-col overflow-hidden rounded-[15px] bg-white p-5\",\"children\":[[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"pointer-events-none absolute inset-0 bg-[radial-gradient(140%_70%_at_0%_0%,rgba(244,244,245,0.7),transparent_60%)]\"}],[\"$\",\"div\",null,{\"className\":\"relative flex h-full flex-col\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-2 flex items-center gap-2\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-poppins text-[17px] font-semibold leading-[1.5rem] text-zinc-800\",\"children\":\"Team\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1 rounded-full bg-zinc-100 px-2 py-0.5 text-[10px] font-medium text-zinc-500\",\"children\":\"Coming soon\"}]]}],[\"$\",\"div\",null,{\"className\":\"mb-1 flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5\",\"children\":[\"$\",\"span\",null,{\"className\":\"font-poppins text-[26px] font-medium leading-none tracking-[-1px] text-zinc-800\",\"children\":\"Contact us\"}]}],[\"$\",\"p\",null,{\"className\":\"mb-3.5 min-h-[30px] text-sm leading-relaxed text-zinc-800\",\"children\":\"For teams that need collaboration, controls, and custom usage.\"}],[\"$\",\"div\",null,{\"className\":\"mb-3 h-px bg-zinc-100\"}],[\"$\",\"div\",null,{\"className\":\"mb-4 flex flex-1 flex-col gap-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"flex h-4 w-4 items-center justify-center rounded-full bg-stone-100\",\"children\":[\"$\",\"svg\",null,{\"viewBox\":\"0 0 256 256\",\"className\":\"h-2.5 w-2.5 text-stone-500\",\"fill\":\"currentColor\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"d\":\"M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z\"}]}]}],[\"$\",\"span\",null,{\"className\":\"text-[13px] text-zinc-800\",\"children\":\"Multi-user workspaces\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"flex h-4 w-4 items-center justify-center rounded-full bg-stone-100\",\"children\":[\"$\",\"svg\",null,{\"viewBox\":\"0 0 256 256\",\"className\":\"h-2.5 w-2.5 text-stone-500\",\"fill\":\"currentColor\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"d\":\"M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z\"}]}]}],[\"$\",\"span\",null,{\"className\":\"text-[13px] text-zinc-800\",\"children\":\"Admin controls \u0026 roles\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"flex h-4 w-4 items-center justify-center rounded-full bg-stone-100\",\"children\":[\"$\",\"svg\",null,{\"viewBox\":\"0 0 256 256\",\"className\":\"h-2.5 w-2.5 text-stone-500\",\"fill\":\"currentColor\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"d\":\"M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z\"}]}]}],[\"$\",\"span\",null,{\"className\":\"text-[13px] text-zinc-800\",\"children\":\"Centralized billing \u0026 seat management\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"flex h-4 w-4 items-center justify-center rounded-full bg-stone-100\",\"children\":[\"$\",\"svg\",null,{\"viewBox\":\"0 0 256 256\",\"className\":\"h-2.5 w-2.5 text-stone-500\",\"fill\":\"currentColor\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"d\":\"M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z\"}]}]}],[\"$\",\"span\",null,{\"className\":\"text-[13px] text-zinc-800\",\"children\":\"Collaboration \u0026 approvals\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"flex h-4 w-4 items-center justify-center rounded-full bg-stone-100\",\"children\":[\"$\",\"svg\",null,{\"viewBox\":\"0 0 256 256\",\"className\":\"h-2.5 w-2.5 text-stone-500\",\"fill\":\"currentColor\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"d\":\"M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z\"}]}]}],\"$L78\"]}],\"$L79\"]}],\"$L7a\"]}]]}]}]\n"])</script><script>self.__next_f.push([1,"4b:[\"$\",\"a\",null,{\"href\":\"/pricing\",\"className\":\"inline-flex items-center gap-1.5 font-sans text-sm font-medium text-purple-500 no-underline transition-colors hover:text-purple-600\",\"children\":[\"See full pricing \u0026 compare every feature\",[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"→\"}]]}]\n4c:[\"$\",\"p\",null,{\"children\":\"You don't have to start from a blank canvas either: the marketplace is full of ready-made agents you can deploy in a click and then tweak to fit how you work. A good rule of thumb — if you can describe the job clearly enough to hand it to a capable assistant, you can build an AI agent for it, and the agent will keep doing it on whatever schedule or trigger you choose.\"}]\n"])</script><script>self.__next_f.push([1,"4d:[\"$\",\"details\",null,{\"className\":\"faq__item\",\"name\":\"faq\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"faq__q\",\"children\":[\"How does AutoGPT compare to hiring a contractor?\",[\"$\",\"svg\",null,{\"className\":\"faq__icon\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"d\":\"M12 5v14M5 12h14\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"faq__a\",\"children\":[[\"$\",\"p\",null,{\"children\":\"A contractor is the right call for judgement-heavy, one-off work — a brand redesign, a tricky migration, advice you'll act on once. AutoGPT is built for the repeatable kind of work that comes back every day or every week. An agent runs around the clock, handles many tasks in parallel, responds in seconds rather than days, and costs a fraction of an hourly rate, because you only pay for the compute and model usage each run actually consumes.\"}],[\"$\",\"p\",null,{\"children\":\"Agents also don't context-switch or take holidays: the daily briefing lands every morning and the competitor watch never blinks. They're not a replacement for human judgement on novel, high-stakes decisions — they're leverage for everything that happens again and again. Most people end up using both: a person for the bespoke work, and a handful of agents for the recurring tasks that used to eat that person's week.\"}]]}]]}]\n"])</script><script>self.__next_f.push([1,"4e:[\"$\",\"details\",null,{\"className\":\"faq__item\",\"name\":\"faq\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"faq__q\",\"children\":[\"How is AutoGPT different from Claude Code, Codex, or Perplexity?\",[\"$\",\"svg\",null,{\"className\":\"faq__icon\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"d\":\"M12 5v14M5 12h14\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"faq__a\",\"children\":[[\"$\",\"p\",null,{\"children\":\"They solve different problems. Claude Code and Codex help you write code, and Perplexity answers questions with sources — they assist you, in the moment, while you're actively prompting them. AutoGPT is an AI agent platform: you build agents that run on their own, across your apps, on a schedule or a trigger, doing the whole job end to end rather than the part you're working on right now.\"}],[\"$\",\"p\",null,{\"children\":[\"Put differently, an assistant helps you draft one reply; an agent clears the queue while you're in a meeting. The two are complementary — plenty of AutoGPT users still reach for a coding assistant or an answer engine during the day, then let agents own the recurring work. For a side-by-side look at how AutoGPT stacks up against automation tools and agent frameworks, see our \",[\"$\",\"a\",null,{\"href\":\"/compare\",\"children\":\"comparison pages\"}],\" covering Zapier, n8n, LangChain, and more.\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"4f:[\"$\",\"details\",null,{\"className\":\"faq__item\",\"name\":\"faq\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"faq__q\",\"children\":[\"Can I use AutoGPT for free?\",[\"$\",\"svg\",null,{\"className\":\"faq__icon\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"d\":\"M12 5v14M5 12h14\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"faq__a\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"Yes, if you're technical: AutoGPT is \",[\"$\",\"a\",null,{\"href\":\"https://github.com/Significant-Gravitas/AutoGPT\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"open source\"}],\", so you can self-host the whole platform for free on your own infrastructure — you bring your own model API keys and hardware, and there's no licence fee or seat limit. Everything you build there maps over to the cloud later if you switch.\"]}],[\"$\",\"p\",null,{\"children\":\"The hosted cloud doesn't have a free tier, and that's deliberate: every agent run uses real compute and paid AI-model usage that we cover on your behalf, so a free plan would mean throttling agents into uselessness. Instead, each plan includes enough usage to put agents to work from day one — AutoPilot Chat, the visual builder, the marketplace, and a credit wallet for your agents' runs. If you want to kick the tyres before paying, self-hosting is the genuinely free path — and the open-source repo is the same codebase the cloud runs.\"}]]}]]}]\n"])</script><script>self.__next_f.push([1,"50:[\"$\",\"details\",null,{\"className\":\"faq__item\",\"name\":\"faq\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"faq__q\",\"children\":[\"What are credits, and what counts as usage?\",[\"$\",\"svg\",null,{\"className\":\"faq__icon\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"d\":\"M12 5v14M5 12h14\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"faq__a\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Running agents is pay-as-you-go: each run draws from a pre-paid credit wallet you can top up any time, and the rate is the same on every plan — you never pay a premium per task for being on a smaller tier. Usage is what your agents actually consume: the AI-model calls they make, the compute their blocks use, and any premium integrations they touch along the way.\"}],[\"$\",\"p\",null,{\"children\":[\"Light agents cost very little per run; heavy research agents cost more, and the dashboard shows exactly what every run consumed, so there are no surprises at the end of the month. Your subscription (Pro or Max) sets how much AutoPilot Chat usage is included — that's the main difference between the plans. In short: the subscription covers chat, the credit wallet covers the agents you run, and the \",[\"$\",\"a\",null,{\"href\":\"/pricing\",\"children\":\"pricing page\"}],\" has the full breakdown.\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"51:[\"$\",\"details\",null,{\"className\":\"faq__item\",\"name\":\"faq\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"faq__q\",\"children\":[\"Can I self-host AutoGPT?\",[\"$\",\"svg\",null,{\"className\":\"faq__icon\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"d\":\"M12 5v14M5 12h14\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"faq__a\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Yes. AutoGPT is open source, and you can run the entire platform yourself with a single Docker Compose command — on Linux, WSL, Podman, even a Raspberry Pi. Self-hosting is free: you bring your own model API keys and infrastructure, and you get the same visual builder, block library, and agent runtime the cloud runs.\"}],[\"$\",\"p\",null,{\"children\":[\"It's the right choice when data can't leave your network, when you want full control over models and costs, or when you simply like running your own stack. The hosted cloud is the managed, zero-setup alternative — we run the servers, cover model usage through your plan, and keep everything up to date. Plenty of teams prototype in the cloud and move sensitive workloads on-prem later, or start self-hosted and graduate to the cloud as they scale. Start from the \",[\"$\",\"a\",null,{\"href\":\"https://github.com/Significant-Gravitas/AutoGPT\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"GitHub repo\"}],\", or follow the self-hosting guide in the \",[\"$\",\"a\",null,{\"href\":\"https://agpt.co/docs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"docs\"}],\".\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"52:[\"$\",\"p\",null,{\"className\":\"faq__foot\",\"children\":[\"Still have a question? Read the \",[\"$\",\"a\",null,{\"href\":\"https://agpt.co/docs\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"c