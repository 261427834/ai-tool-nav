ame\":\"text-[14px] leading-snug text-zinc-800\",\"children\":\"Go from idea to working agent in one chat.\"}]]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-purple-50\",\"children\":[\"$\",\"svg\",null,{\"viewBox\":\"0 0 256 256\",\"className\":\"h-3 w-3 text-purple-500\",\"fill\":\"currentColor\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"d\":\"M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z\"}]}]}],\"$L29\"]}],\"$L2a\",\"$L2b\",\"$L2c\"]}],\"$L2d\"]}],\"$L2e\"]}],\"$L2f\",\"$L30\",\"$L31\"]}]]}]}]\n"])</script><script>self.__next_f.push([1,"13:[\"$\",\"section\",null,{\"className\":\"integrations\",\"aria-labelledby\":\"integrations-title\",\"data-fast-scroll\":\"scroll_to_integrations\",\"children\":[\"$\",\"div\",null,{\"className\":\"integrations__container\",\"children\":[[\"$\",\"header\",null,{\"className\":\"integrations__head\",\"children\":[[\"$\",\"p\",null,{\"className\":\"demo__eyebrow\",\"children\":\"Integrations\"}],[\"$\",\"h2\",null,{\"className\":\"integrations__title\",\"id\":\"integrations-title\",\"children\":[\"Connect what's yours. \",[\"$\",\"em\",null,{\"children\":\"We've wired up the rest.\"}]]}],[\"$\",\"p\",null,{\"className\":\"integrations__sub\",\"children\":\"Every model, built in. No API keys, no setup — just connect the tools that are already yours and your agents get to work.\"}],[\"$\",\"ul\",null,{\"className\":\"intg-caps\",\"aria-label\":\"What the models can do\",\"children\":[[\"$\",\"li\",null,{\"children\":\"Chat \u0026 reasoning\"}],[\"$\",\"li\",null,{\"children\":\"Image generation\"}],[\"$\",\"li\",null,{\"children\":\"Video generation\"}],[\"$\",\"li\",null,{\"children\":\"Text-to-speech\"}],[\"$\",\"li\",null,{\"children\":\"Transcription\"}],[\"$\",\"li\",null,{\"children\":\"Music\"}],[\"$\",\"li\",null,{\"children\"