  <section class="section image-background">
    <div class="image-background-text">
      <div class="container">
        <div class="_12-columns">
          <div class="column desktop-8 tablet-12">
            <div class="text-center scale-up">
              <h1 class="heading xl">Try Our AI Artwork Generator for Free</h1>
              <p class="paragraph">From logos and characters to digital artwork and photos,  just describe the image you want and our AI image generating tool will create the perfect graphic for your project. It’s FREE to try.</p>
              <div class="w-form">
                <form id="wf-form-Prompt-Form-on-Index-Page" name="wf-form-Prompt-Form-on-Index-Page" data-name="Prompt Form on Index Page" method="get" class="form-4 margins_noforget" data-wf-page-id="63f7c5a4ccb620a5c27ed15b" data-wf-element-id="61b4807a-54cd-46c2-c8c2-94d2e3cf9d3f"><label for="Prompt" class="field-label">Try BlueWillow for free by entering a prompt below</label><textarea id="Prompt" name="Prompt" maxlength="5000" data-name="Prompt" placeholder="Example: &quot;A lion&#x27;s face appearing in the blue shaded sky&quot;" class="textarea no_resize color_white w-input"></textarea><input type="submit" data-wait="Please wait..." class="button prompt_submit w-button" value="Generate Artwork"></form>
                <div class="w-form-done">
                  <div>Thank you! Your submission has been received!</div>
                </div>
