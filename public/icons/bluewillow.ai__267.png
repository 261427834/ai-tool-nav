  <script>
  const params = window.location.search;
	const urlParams = new URLSearchParams(params)
  const utmSource = "utm_source"
  const MAILCHIMP_DISCORD_TAG_ID="372524"
  if (urlParams.has(utmSource)) {
    const source = urlParams.get(utmSource)
    if (source?.toLowerCase() === "discord") {
       $("#mailchimp-tag").val(MAILCHIMP_DISCORD_TAG_ID);
    }
  }
  // enter prompt
  document.querySelector('#enter_prompt').addEventListener('click', function(e) {
  window.scrollTo({top: 0, behavior: 'smooth'});
  document.getElementById("Prompt").focus();
  });
  // submit prompt
  document.querySelector("#wf-form-Prompt-Form-on-Index-Page").addEventListener("submit", function(e){
   const url = new URL('https://limewire.com/studio/image/create-image');
   
   url.searchParams.set('model', 'BWTXT2IMGV5');
   url.searchParams.set('modelOptions', JSON.stringify({ prompt: document.getElementById("Prompt").value }));
   url.searchParams.set('submit', 'true');
   
   window.location.href = url.href;
   return false;
	});
</script>
