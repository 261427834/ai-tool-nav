				} else if (!phoneRegex.test(phone)) {
					alert('手机号格式不正确');
				} else {
					fetch('https://idword.cn/upload-phone', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json'
							},
							body: JSON.stringify({
								phone: phone
							})
						})
						.then(response => response.json())
						.then(data => {
							alert('手机号上传成功，我们会尽快与您取得联系');
							$('#Enter_text1').val(''); // 清空输入框
						})
						.catch(error => {
							alert('手机号上传失败，请重试');
						});
