			fetch('https://idword.cn/track-event', {
					method: 'GET',
					headers: {
						'Content-Type': 'application/json'
					}
				})
				.then(response => response.json())
				.then(data => {})
				.catch(error => {});

			// 显示弹出窗口
			function showPopup() {
				$('#overlay').show();
				$('#popup').show();
			}

			// 隐藏弹出窗口
			function hidePopup() {
				$('#overlay').hide();
				$('#popup').hide();
			}

			// 表单提交处理函数
			function handleFormSubmit(event) {
				console.log("11111111111111111");

				event.preventDefault();
				var name = $('#name').val();
				var company = $('#company').val();
				var city = $('#city').val();
				var phone = $('#phone').val();
				var phoneRegex = /^1[3-9]\d{9}$/; // 手机号正则表达式

				if (!phone) {
					alert('请输入您的手机号');
				} else if (!phoneRegex.test(phone)) {
					alert('手机号格式不正确');
				} else {
					fetch('https://idword.cn/upload-phone', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json'
							},
							body: JSON.stringify({
								name: name,
								company: company,
								city: city,
								phone: phone
							})
						})
						.then(response => response.json())
						.then(data => {
							alert('信息上传成功，我们会尽快与您取得联系');
							hidePopup();
							$('#consultForm')[0].reset(); // 清空表单
						})
						.catch(error => {
							alert('信息上传失败，请重试');
						});
				}
			}

			// 处理 zixun1 按钮点击事件
			$('#zixun1').click(function(event) {
