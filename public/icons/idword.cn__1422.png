	<script>
		// 切换图片
		function scrollToImage(index) {
    const titlesContainer = document.querySelector('#titlesContainer');
    const imagesContainer = document.querySelector('#imagesContainer');

    const titleWidth = document.querySelector('.title').offsetWidth;
    const imageWidth = document.querySelector('.image-wrapper').offsetWidth;

    const titlesContainerWidth = titlesContainer.offsetWidth;
    const imagesContainerWidth = imagesContainer.offsetWidth;

    const titlesScrollPosition = index * titleWidth - (titlesContainerWidth / 2) + (titleWidth / 2);
    const imagesScrollPosition = index * imageWidth - (imagesContainerWidth / 2) + (imageWidth / 2);

    titlesContainer.scrollTo({
        left: titlesScrollPosition,
        behavior: 'smooth'
    });

    imagesContainer.scrollTo({
        left: imagesScrollPosition,
        behavior: 'smooth'
    });

    // 更新活动标题
    updateActiveTitle(index);
}

function updateActiveTitle(index) {
    const titles = document.querySelectorAll('.title');
    titles.forEach((title, i) => {
        if (i === index) {
            title.classList.add('active');
        } else {
            title.classList.remove('active');
        }
    });
}

// 根据初始滚动位置初始化活动标题
window.addEventListener('load', () => {
    const titlesContainer = document.querySelector('#titlesContainer');
    const titles = document.querySelectorAll('.title');
    const scrollLeft = titlesContainer.scrollLeft;
    const titleWidth = document.querySelector('.title').offsetWidth;
    const activeIndex = Math.round(scrollLeft / titleWidth);
    updateActiveTitle(activeIndex);
});

// 处理滚动事件更新活动标题
document.querySelector('#titlesContainer').addEventListener('scroll', () => {
    const titlesContainer = document.querySelector('#titlesContainer');
    const scrollLeft = titlesContainer.scrollLeft;
    const titleWidth = document.querySelector('.title').offsetWidth;
    const activeIndex = Math.round(scrollLeft / titleWidth);
    updateActiveTitle(activeIndex);
});

document.querySelector('#imagesContainer').addEventListener('scroll', () => {
    const imagesContainer = document.querySelector('#imagesContainer');
    const scrollLeft = imagesContainer.scrollLeft;
    const imageWidth = document.querySelector('.image-wrapper').offsetWidth;
    const activeIndex = Math.round(scrollLeft / imageWidth);
    updateActiveTitle(activeIndex);
});



		// 显示弹窗
		document.getElementById('trialButton').addEventListener('click', function() {
			document.getElementById('overlay').style.display = 'block';
			document.getElementById('popup').style.display = 'block';
			document.getElementById('moveButton').style.display = 'none';
		});

		// 关闭弹窗
		document.querySelector('.close').addEventListener('click', function() {
			document.getElementById('overlay').style.display = 'none';
			document.getElementById('popup').style.display = 'none';
			document.getElementById('moveButton').style.display = 'block';
			document.getElementById('trialForm').reset(); // 清空表单内容
		});

		// 阻止表单默认提交行为并打开登录页面
		$('#goLogin').click(function(event) {
			event.preventDefault();
			window.open('https://ai.idword.cn/login', '_blank');
		});


		// 检查是否为移动端
		function checkMobile() {
			const isMobile = window.innerWidth <= 700; // 假设700px为手机屏幕宽度
			document.getElementById("mobile").style.display = isMobile ? "block" : "none";
			document.getElementById("unMobile").style.display = isMobile ? "none" : "flex";
		}

