<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js" integrity="sha512-3gJwYpMe3QewGELv8k/BX9vcqhryRdzRMxVfq6ngyWXwo03GFEzjsUm8Q7RZcHPHksttq7/GFoxjCVUjkjvPdw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.8/umd/popper.min.js" integrity="sha512-TPh2Oxlg1zp+kz3nFA0C5vVC6leG/6mm1z9+mA81MI5eaUVqasPLO8Cuk4gMF4gUfP5etR73rgU/8PNMsSesoQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.2.3/js/bootstrap.min.js" integrity="sha512-1/RvZTcCDEUjY/CypiMz+iqqtaoQfAITmNSJY17Myp4Ms5mdxPS5UV7iOfdZoxcGhzFbOm6sntTKJppjvuhg4g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js" integrity="sha512-lbwH47l/tPXJYG9AcFNoJaTMhGvYWhVM9YI43CT+uteTRRaiLCui8snIgyAN8XWgNjNhCqlAUdzZptso6OCoFQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/js-cookie/2.0.4/js.cookie.min.js" integrity="sha512-Nonc2AqL1+VEN+97F3n4YxucBOAL5BgqNwEVc2uUjdKOWAmzwj5ChdJQvN2KldAxkCxE4OenuJ/RL18bWxGGzA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://static.promptfolder.com/static/js/scripts.js?v=15" ></script>

<!-- Toastr settings -->
<script type="text/javascript" src="https://static.promptfolder.com/static/js/toastr_settings.js"></script>



    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js" integrity="sha512-2ImtlRlf2VVmiGZsjm9bEyhjGW4dU7B6TNwh/hx/iSByxNENtj3WVE6o/9Lj4TJeVXPi4bnOIMXFIJJAeufa0A==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://static.promptfolder.com/static/js/copy_to_clipboard.js"></script>
    <script>
    $(document).ready(function (){
        $("#id_user_input_text").on("keyup keydown keypress", function (){
            combinePromptAndForms(is_from_input=true);
        })

        $("#params_form").on("change", function (){
            combinePromptAndForms();
        })

        function getUserInputTextWithoutComments(){
            user_input_text_wo_comments = ""
            comments = ""
            user_input = $("#id_user_input_text").val();
            var lines = user_input.split('\n');
            $.each(lines, function(index, line){
                if(line.substr(0, 1) != "#"){
                    user_input_text_wo_comments += line;
                }else{
                    comments += line+"\n";
                }
            })
            return [user_input_text_wo_comments, comments]
        }

        function combinePromptAndForms(is_from_input=false){
            if(is_from_input){
                [prompt_text, comments] = getUserInputTextWithoutComments();
                last_character = prompt_text.substr(-1);

                if (prompt_text.indexOf('::') == -1) {
                    if (prompt_text.match("::$")) {
                        prompt_text = prompt_text;
                    }else if(!prompt_text.match(":$")){
                        prompt_text = prompt_text +"::";
                    }
                }else if(last_character.charCodeAt(0) != 10 && last_character != ":" && !$.isNumeric(last_character)){
                    prompt_text = prompt_text +"::";
                }
                $("#id_comments").val(comments);
            }else{
                prompt_text = ""
                $(".user-input-slider").each(function (){
                    full_text = $(this).find(".full-text").text();
                    value = $(this).find(".form-range").val();
                    prompt_text += full_text+"::"+value+" ";
                })
                prompt_text = prompt_text.trim();
            }

            multi_prompt_params = getMjMultiPromptParams()
            params_text = getSelectedParams();

            image = $("#mj_image_adding_modal input:checked");
            image_url = image.length == 1 ? image.attr("data-img-url")+" " : ""
            combined_text = "/imagine prompt: "+ image_url + prompt_text + multi_prompt_params + params_text;

            $("#id_text").val(combined_text);
            $("#id_text").get(0).dispatchEvent(new Event('input'));
        }
        combinePromptAndForms();

        function getMjMultiPromptParams(){
            params = "";
            form_fields_array = $("#mj_multi_prompts_form").find("input");
            $.each(form_fields_array, function (index, obj) {
                parameter = $(this).attr("data-name");
                if($(this).prop("checked")){
                    val = $(this).attr("data-parameter-value");
                    params += parameter + "::"+val+" ";
                }
            })
            if(params.endsWith(", ")){
                params = params.slice(0,-2)
            }
            params = params ? " "+params : ""
            return params
        }

        function getSelectedParams(){
            params = "";
            form_fields_array = $("#params_form").find("input, select");
            form_fields_array_length = form_fields_array.length;
            $.each(form_fields_array, function (index, obj){
                param_name = $(this).attr("data-param-name");
                val = $(this).val();
                if(param_name){
                    if(val){
                        if (param_name == "--version" && val == "niji"){
                            param_name = "--niji"
                            val = "5"
                        }
                        if(param_name == "--tile"){
                            if(val == "Yes"){
                                params += param_name+" ";
                            }
                        }else{
                            params += param_name+" "+val+" ";
                        }
                    }
                }
            })
            if(params.endsWith(", ")){
                params = params.slice(0,-2)
            }
            params = params ? " "+params : params
            return params
        }

        $("#save_prompt_button, #save_to_my_prompts_button, #upload_inspirational_images_not_auth").on("click", function (){
            $("#prompt_form").submit();
        })

        $("#copy_prompt_text").on("click", function(){
            text_to_copy = $("#id_text").val();
            copyToClipboard(text_to_copy);
        })

        modal = new bootstrap.Modal("#mj_multi_prompts_modal");
        $(".btn-modal").on("click", function(e){
            clicked_btn = $(this);
            category_name = clicked_btn.attr("data-category");
            $("#mj_multi_prompts_modal").find(".modal-title").text(category_name);

            $("#mj_multi_prompts_modal").find("div[id^='div_id_']").addClass("d-none").removeClass("active-section");
            category_section = $("#mj_multi_prompts_modal").find("#div_id_"+category_name);
            category_section.removeClass("d-none").addClass("active-section");
            updateMjModalButtons();

            category_section.find("input[type='checkbox']").each(function (){
                img_wrapper = $(this).closest(".form-check").find(".mj-parameter-img-wrapper");
                if(img_wrapper.find("img").length == 0){
                    img_url = $(this).attr("data-img-url");
                    if(img_url){
                        img_wrapper.html('<img src="'+img_url+'" class="img-fluid">');
                    }
                }
            });
            modal.show();

            $("#mj_multi_prompts_modal").off("hidden.bs.modal").on("hidden.bs.modal", function () {
                combinePromptAndForms();
                updateSelectedBadges();
                populateParameterSliders();
            })
        })

        function updateSelectedBadges(){
            $(".btn-parameter-category").each(function (){
                category_name = $(this).attr("data-category");
                category_section = $("#mj_multi_prompts_modal").find("#div_id_"+category_name);
                selected_parameters_nmb = category_section.find("input[type='checkbox']:checked").length;
                if(selected_parameters_nmb > 0){
                    $(this).find(".selected-parameters-nmb")
                        .html("<span class='badge-selected-nmb'>"+selected_parameters_nmb+"</span>");
                }else{
                    $(this).find(".selected-parameters-nmb").text("");
                }
            })
        }
        updateSelectedBadges();

        function updateMjModalButtons(){
            category_section = $("#mj_multi_prompts_modal .active-section");
            selected_parameters_nmb = category_section.find("input[type='checkbox']:checked").length;
            if (selected_parameters_nmb > 0){
                $("#close_mj_parameters_modal").text("Clear All & Close");
                $("#save_mj_parameters_from_modal .selected-nmb").text(selected_parameters_nmb);
            }else{
                $("#close_mj_parameters_modal").text("Cancel");
                $("#save_mj_parameters_from_modal .selected-nmb").text(selected_parameters_nmb);
            }
        }

        $(".mj-parameter-wrapper").on("click", function (e){
            if(!$(e.target).hasClass("form-range")){
                obj = $(this);
                val = $(this).find("form-range").val();
                checkbox = obj.parent().find("input[type='checkbox']");
                checkbox.attr("data-parameter-value", val)
                is_checked = obj.hasClass("active") ? false : true;
                checkbox.prop('checked', is_checked);
                obj.toggleClass("active");
            }
            updateMjModalButtons();
        })

        $(document).on("mousemove touchmove click", ".form-range", function (){
            val = $(this).val();
            $(this).closest(".prompt-weighting-slider").find(".range-slider-value").text(val);

            parameter_uuid = $(this).attr("data-for-data-parameter-uuid");
            checkbox = $("[data-parameter-uuid='"+parameter_uuid+"']");
            checkbox.attr("data-parameter-value", val);
            combinePromptAndForms();
        })

        $("#close_mj_parameters_modal").on("click", function (e){
            e.preventDefault();
            active_section = $("#mj_multi_prompts_modal .active-section");
            active_section.find("input[type='checkbox']:checked").prop('checked', false);
            active_section.find(".mj-parameter-wrapper").removeClass("active");
            modal.hide();
        })

        $("#all_parameters_reset").on("click", function(e){
            e.preventDefault();
            deselectImage();
            $("#params_form").find("input, select").val("");
            $("#mj_multi_prompts_modal .mj-parameter-wrapper").removeClass("active");
            $("#mj_multi_prompts_modal form").find("input[type='checkbox']:checked").prop('checked', false);
            updateSelectedBadges();
            combinePromptAndForms();
            populateParameterSliders();

            toastr.success("Done!");
        })

        function getUserInputWeights(){
            prompt_weighting_sliders = $("#prompt_weighting_sliders");
            [text, _] = getUserInputTextWithoutComments();
            data = {
                "csrfmiddlewaretoken": $("#csrf_getting_form").find("[name='csrfmiddlewaretoken']").val(),
                "text": text
            };
            $.ajax({
                async: false,
                url: "/get-user-input-weights/",
                type: "POST",
                data: data,
                success: function (response) {
                    user_input_weights = response.user_input_weights;
                    $.each(user_input_weights, function(){
                        name = this.name;
                        value = this.value === "" ? 3 : this.value;
                        full_text = this.full_text;

                        slider_template = $("#prompt_weighting_slider_template").children(".prompt-weighting-slider").eq(0).clone();
                        slider_template.addClass("user-input-slider");
                        slider_template.find(".parameter-name").text(name);
                        slider_template.find(".full-text").text(full_text);

                        slider_template.find(".form-range").val(value);
                        slider_template.find(".range-slider-value").text(value);

                        prompt_weighting_sliders.append(slider_template);
                    })
                }
            })
        }

        function populateParameterSliders(){
            prompt_weighting_sliders = $("#prompt_weighting_sliders");
            prompt_weighting_sliders.html("");

            getUserInputWeights();

            $("#mj_multi_prompts_modal .mj-parameter-wrapper.active").each(function (){
                checkbox = $(this).closest(".form-check").find("input[type='checkbox']");
                category_name = checkbox.attr("data-category-name");
                parameter_value = checkbox.attr("data-parameter-value");
                parameter_uuid = checkbox.attr("data-parameter-uuid");

                parameter_title = $(this).find(".parameter-name").text();
                slider_title = "<span class='text-capitalize'>" + category_name +"</span>" +": "+parameter_title;

                slider_template = $("#prompt_weighting_slider_template").children(".prompt-weighting-slider").eq(0).clone();
                slider_template.find(".parameter-name").html(slider_title);
                slider_template.find(".form-range").val(parameter_value);
                slider_template.find(".range-slider-value").text(parameter_value);

                slider_template.find(".form-range").attr("data-for-data-parameter-uuid", parameter_uuid);
                prompt_weighting_sliders.append(slider_template);
            })

            if($(document).find("#prompt_weighting_section .prompt-weighting-slider").length > 1){
                $("#prompt_weighting_section").removeClass("d-none")
            }else{
                $("#prompt_weighting_section").addClass("d-none")
            }
        }
        populateParameterSliders();

        $("#id_user_input_text").on("change", function (){
            populateParameterSliders();
        })

        function adjustTextArea(){
            $("textarea").each(function(){
                var cs = window.getComputedStyle(this);
                height = (this.scrollHeight + parseInt(cs.getPropertyValue("border-top-width")) + parseInt(cs.getPropertyValue("border-bottom-width"))) + "px";
                $(this).css("height", height);
            })
        }

        adjustTextArea();

        events = ["input", "change"]
        events.forEach( function(evt) {
            document.querySelectorAll("textarea").forEach(function (el) {
                el.addEventListener(evt, function () {
                    var cs = window.getComputedStyle(this);
                    // reset height to allow textarea to shrink again
                    this.style.height = "auto";
                    // when "box-sizing: border-box" we need to add vertical border size to scrollHeight
                    this.style.height = (this.scrollHeight + parseInt(cs.getPropertyValue("border-top-width")) + parseInt(cs.getPropertyValue("border-bottom-width"))) + "px";
                });
            });
        })

        function adjustImagesUploadingButtons(){
            $("#import_images_btn").toggleClass("d-none");
            $("#images_uploading_btn").toggleClass("d-none");
        }

        function deselectImage(){
            active_image_wrapper = $(document).find("#mj_image_adding_modal .image-field-wrapper.active");
            if(active_image_wrapper.length > 0){
                active_image_wrapper.click();
            }
        }

        

        $("#optimize_prompt").on("click", function (){
            prompt = $("#id_user_input_text").val();
            if(prompt){
                $("#optimized_prompt_loading").removeClass("d-none");

                $("#optimized_prompt").html("");
                $("#optimized_prompt_to_display").html("");

                data = {
                    "csrfmiddlewaretoken": $("#csrf_getting_form").find("[name='csrfmiddlewaretoken']").val(),
                    "prompt": prompt
                }
                $.ajax({
                    url: "/optimize-prompt/midjourney/",
                    type: "POST",
                    data: data,
                    success: function (response) {
                        if(response.status == "success"){
                            $("#optimized_prompt_modal .buttons-wrapper, #optimized_prompt_wrapper").addClass("d-none");
                            $("#optimized_prompt_modal").modal("show");

                            $("#optimized_prompt_loading").addClass("d-none");
                            $("#optimized_prompt_modal .buttons-wrapper, #optimized_prompt_wrapper").removeClass("d-none");

                            $("#optimized_prompt").html(response.optimized_prompt);
                            $("#optimized_prompt_to_display").html(response.optimized_prompt.replace(/\n/g, "<br/>"));

                            $("#accept_optimized_prompt").attr("data-uuid", response.uuid)
                        }else if(response.redirect_url){
                            window.location.href = response.redirect_url;
                        }else{
                            alert("Error! Try again!")
                        }
                    },
                    error: function (response) {

                    },
                });
            }else{

            }
        })

        $("#accept_optimized_prompt").on("click", function (){
            uuid = $(this).attr("data-uuid");
            $("#id_user_input_text").val($("#optimized_prompt").text());
            combinePromptAndForms(is_from_input=true);
            $("#optimized_prompt_modal").modal("hide");
            adjustTextArea();
            data = {
                "csrfmiddlewaretoken": $("#csrf_getting_form").find("[name='csrfmiddlewaretoken']").val(),
                "uuid": uuid
            }
            $.ajax({
                url: "/optimize-prompt-accepted/",
                type: "POST",
                data: data,
                success: function (response) {

                },
                error: function (response) {

                },
            });
        })

    })
</script>


</body>
</html>
