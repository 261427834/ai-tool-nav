                                     data-category-name="Materials" data-img-url="https://static.promptfolder.com/media/midjourney/parameters/small/d2877263-8849-48e5-859a-ccef84d31286.jpg" data-parameter-uuid="4c56497f-297e-4a7b-8d27-c77c1dfcf06e" data-parameter-value="3"> <label class="form-check-label">
                                Yarn
                            </label> </div> <div class="mj-parameter-wrapper "> <div class="d-flex justify-content-start align-items-center"> <div class="mj-parameter-img-wrapper"></div> <div class="parameter-name">Yarn</div> </div> </div> </div> </div> </div>
</div> </div> </form>

                </div>
            </div>
            <div class="modal-footer">
                <div class="text-end">
                    <button id="close_mj_parameters_modal" class="btn btn-secondary">Cancel</button>
                    <button id="save_mj_parameters_from_modal" class="btn btn-success" data-bs-dismiss="modal">
                        Continue (<span class="selected-nmb">0</span>)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

    

    <div id="prompt_weighting_slider_template" class="d-none">
    <div class="row prompt-weighting-slider">
        <div class="col-lg-4">
            <span class="parameter-name"></span>
            <div class="d-none full-text"></div>
        </div>
        <div class="col-lg-8">
            <div class="form-range-wrapper d-flex justify-content-center align-items-center">
                <div class="range-slider-value mb-2 me-2 w-25 text-end">3</div>
                <div class="form-range-slider w-75">
                    <input class="form-range" type="range" min="1" max="5" step="0.1" value="3">
                </div>
            </div>
        </div>
    </div>
</div>
    <div id="optimized_prompt_modal" class="modal" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-body text-center">
                <div id="optimized_prompt_loading" class="fw-bold">Optimizing Your Prompt with AI Magic...</div>

                <div id="optimized_prompt_wrapper" class="text-start">
                    <div class='fw-bold'>AI Optimized Prompt:</div>
                    <div id="optimized_prompt" class="d-none"></div>
                    <div id="optimized_prompt_to_display"></div>
                </div>

                <div class="buttons-wrapper text-center mt-3">
                    <button id="accept_optimized_prompt" class="btn btn-success" data-bs-dismiss="modal">
                        Accept
                    </button>
                    <button type="button" data-bs-dismiss="modal" class="btn btn-secondary">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>
    <div id="delete_image_confirmation_modal" class="modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Are you sure you want to delete this image?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center">
                    <button class="btn btn-primary me-1 mb-1 confirm-action">Yes</button>
                    <button type="button" class="btn btn-secondary mb-1" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

