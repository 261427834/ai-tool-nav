<form  class="mj-form" id="params_form" method="post" > <div  
    class="row" > <div  
    class="col-sm-4 col-lg-2" > <div id="div_id_aspect" class="mb-3"> <label for="id_aspect" class="form-label"> <i class='fa-sharp fa-regular fa-crop-simple'></i> Aspect Ratio <span data-bs-toggle='tooltip' title='Change the aspect ratio (the width-to-height ratio) of the generated image. Default is 1:1.'><i class='fa-sharp fa-solid fa-circle-info'></i></span> </label> <select name="aspect" data-param-name="--aspect" data-tooltip="Change the aspect ratio (the width-to-height ratio) of the generated image. Default is 1:1." class="select form-select" id="id_aspect"> <option value="" selected>----</option> <option value="1:1">1:1</option> <option value="5:4">5:4</option> <option value="3:2">3:2</option> <option value="7:4">7:4</option> <option value="16:9">16:9</option> <option value="2:1">2:1</option> <option value="9:16">9:16</option> <option value="1:2">1:2</option>

</select> </div> </div>
<div  
    class="col-sm-4 col-lg-2" > <div id="div_id_version" class="mb-3"> <label for="id_version" class="form-label"> <i class='fa-sharp fa-regular fa-computer-classic'></i> Version <span data-bs-toggle='tooltip' title='Specify the Midjourney model to use. Default is 5.2.'><i class='fa-sharp fa-solid fa-circle-info'></i></span> </label> <select name="version" data-param-name="--version" class="select form-select" id="id_version"> <option value="" selected>----</option> <option value="6">6</option> <option value="5.2">5.2</option> <option value="5.1">5.1</option> <option value="5">5</option> <option value="4">4</option> <option value="3">3</option> <option value="2">2</option> <option value="1">1</option> <option value="niji">niji</option>

</select> </div> </div>
<div  
    class="col-sm-4 col-lg-2" > <div id="div_id_quality" class="mb-3"> <label for="id_quality" class="form-label"> <i class='fa-sharp fa-regular fa-shield-check'></i> Quality <span data-bs-toggle='tooltip' title='Decide how much time is spent generating an image (higher number, higher quality). Default is 1.'><i class='fa-sharp fa-solid fa-circle-info'></i></span> </label> <select name="quality" data-param-name="--quality" class="select form-select" id="id_quality"> <option value="" selected>----</option> <option value=".25">.25</option> <option value=".5">.5</option> <option value="1">1</option>

</select> </div> </div>
<div  
    class="col-sm-4 col-lg-2" > <div id="div_id_stylize" class="mb-3"> <label for="id_stylize" class="form-label"> <i class='fa-sharp fa-regular fa-swatchbook'></i> Stylize <span data-bs-toggle='tooltip' title='Low values will closely match the prompt but are less artistic. High values will be very artistic but less connected to the prompt. Default is 100.'><i class='fa-sharp fa-solid fa-circle-info'></i></span> </label> <input type="number" name="stylize" min="0" max="1000" data-param-name="--stylize" placeholder="0 to 1000" class="numberinput form-control" id="id_stylize"> </div> </div>
<div  
    class="col-sm-4 col-lg-2" > <div id="div_id_chaos" class="mb-3"> <label for="id_chaos" class="form-label"> <i class='fa-sharp fa-regular fa-tornado'></i> Chaos <span data-bs-toggle='tooltip' title='Influence how varied your image grid will be. Higher chaos means more unusual and unexpected results. Default is 0.'><i class='fa-sharp fa-solid fa-circle-info'></i></span> </label> <input type="number" name="chaos" min="0" max="100" data-param-name="--chaos" placeholder="0 to 100" class="numberinput form-control" id="id_chaos"> </div> </div>
<div  
    class="col-sm-4 col-lg-2" > <div id="div_id_stop" class="mb-3"> <label for="id_stop" class="form-label"> <i class='fa-sharp fa-regular fa-circle-stop'></i> Stop <span data-bs-toggle='tooltip' title='Create blurrier, less detailed results by stopping your job partway through. Default is 100.'><i class='fa-sharp fa-solid fa-circle-info'></i></span> </label> <input type="number" name="stop" min="10" max="100" data-param-name="--stop" placeholder="10 to 100" class="numberinput form-control" id="id_stop"> </div> </div>
<div  
    class="col-sm-4 col-lg-2" > <div id="div_id_repeat" class="mb-3"> <label for="id_repeat" class="form-label"> <i class='fa-sharp fa-regular fa-repeat'></i> Repeat <span data-bs-toggle='tooltip' title='Run your prompt multiple times.'><i class='fa-sharp fa-solid fa-circle-info'></i></span> </label> <input type="number" name="repeat" min="2" max="40" data-param-name="--repeat" placeholder="2 to 40" class="numberinput form-control" id="id_repeat"> </div> </div>
<div  
    class="col-sm-4 col-lg-2" > <div id="div_id_weird" class="mb-3"> <label for="id_weird" class="form-label"> <i class='fa-sharp fa-regular fa-alien-8bit'></i> Weird <span data-bs-toggle='tooltip' title='Introduce quirky and offbeat qualities to your images, resulting in unique and unexpected outcomes. Default is 0.'><i class='fa-sharp fa-solid fa-circle-info'></i></span> </label> <input type="number" name="weird" min="0" max="3000" data-param-name="--weird" placeholder="0 to 3000" class="numberinput form-control" id="id_weird"> </div> </div>
<div  
    class="col-sm-4 col-lg-2" > <div id="div_id_tile" class="mb-3"> <label for="id_tile" class="form-label"> <i class='fa-sharp fa-regular fa-table-cells'></i> Tile <span data-bs-toggle='tooltip' title='Generate images that can be used as repeating tiles to create seamless patterns for fabrics, wallpapers and textures.'><i class='fa-sharp fa-solid fa-circle-info'></i></span> </label> <select name="tile" data-param-name="--tile" class="select form-select" id="id_tile"> <option value="No">No</option> <option value="Yes">Yes</option>

</select> </div> </div>
<div  
    class="col-sm-4 col-lg-2" > <div id="div_id_seed" class="mb-3"> <label for="id_seed" class="form-label"> <i class='fa-sharp fa-regular fa-input-numeric'></i> Seed <span data-bs-toggle='tooltip' title='If you use the same seed number and prompt, you will get similar final images. Default is random.'><i class='fa-sharp fa-solid fa-circle-info'></i></span> </label> <input type="number" name="seed" min="0" max="4294967295" data-param-name="--seed" placeholder="0 to 4294967295" class="numberinput form-control" id="id_seed"> </div> </div>
<div  
    class="col-sm-4 col-lg-2" > <div id="div_id_no" class="mb-3"> <label for="id_no" class="form-label"> <i class='fa-sharp fa-regular fa-axe'></i> Exclude <span data-bs-toggle='tooltip' title='Tell the Midjourney Bot what not to include in your image.'><i class='fa-sharp fa-solid fa-circle-info'></i></span> </label> <input type="text" name="no" data-param-name="--no" placeholder="Avoid these terms in the image" class="textinput form-control" id="id_no"> </div> </div>

</div> </form>

